{
    "name": "pixiekat/empathica-chatbot",
    "description": "EMPATHICA: a simulated pharmacist chatbot (Anthropic, Gemini, OpenAI, Mistral, EmpathicaAgent) packaged as a plug-and-play Symfony bundle.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Katherine Elizabeth",
            "email": "katie@pixiekitten.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pixiekat\\EmpathicaChatbot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pixiekat\\EmpathicaChatbot\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.7 || ^4.0",
        "doctrine/orm": "^3.5",
        "erusev/parsedown": "^1.7",
        "google/auth": "^1.50",
        "guzzlehttp/guzzle": "^7.8",
        "pixiekat/symfony-common-helpers": "dev-main",
        "symfony/asset-mapper": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/monolog-bundle": "^3.10 || ^4.0",
        "symfony/rate-limiter": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    }
}
